# ==============================================================================
# PLANPOCKET ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env or .env.local and fill in your actual values.
# NEVER commit your real .env or secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Authentication (Public / Client-Safe)
# ------------------------------------------------------------------------------
# Where to obtain:
#   1. Sign in to https://supabase.com and create/open your project.
#   2. Navigate to: Project Settings -> API.
#   3. Copy the "Project URL" and the "Project API keys" -> "anon" (public).
# Where to configure in Vercel:
#   Project Settings -> Environment Variables -> Add VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# 2. MongoDB Atlas Database (SERVER-ONLY — NEVER EXPOSE TO CLIENT)
# ------------------------------------------------------------------------------
# Where to obtain:
#   1. Sign in to https://cloud.mongodb.com and create/open your Atlas cluster.
#   2. Navigate to: Database -> Connect -> Drivers -> Node.js.
#   3. Copy the connection string format:
#      mongodb+srv://<db_user>:<db_password>@<cluster-address>/planpocket?retryWrites=true&w=majority
#   4. Ensure Network Access in Atlas includes your server IP or 0.0.0.0/0 (for Vercel).
# Where to configure in Vercel:
#   Project Settings -> Environment Variables -> Add MONGODB_URI and MONGODB_DB_NAME (Server only)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@your-cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=planpocket

